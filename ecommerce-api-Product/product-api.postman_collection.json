{
  "info": {
    "_postman_id": "c2c4e2b1-6e5e-4d65-9a7f-6b89d3dbf7c1",
    "name": "Product API",
    "description": "Requests for all Product API endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8501"
    },
    {
      "key": "categoryId",
      "value": "1"
    },
    {
      "key": "productId",
      "value": "1"
    },
    {
      "key": "productIdentifier",
      "value": "postman-produto-teste"
    }
  ],
  "item": [
    {
      "name": "Categories",
      "item": [
        {
          "name": "List categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/category"
          }
        },
        {
          "name": "Find category by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/category/{{categoryId}}"
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List products",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/product"
          }
        },
        {
          "name": "List products with pagination",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/product/pageable?page=0&size=10&sort=nome,asc",
              "host": ["{{baseUrl}}"],
              "path": ["product", "pageable"],
              "query": [
                {"key": "page", "value": "0"},
                {"key": "size", "value": "10"},
                {"key": "sort", "value": "nome,asc"}
              ]
            }
          }
        },
        {
          "name": "List products by category",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/product/category/{{categoryId}}"
          }
        },
        {
          "name": "Find product by identifier",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/product/{{productIdentifier}}"
          }
        },
        {
          "name": "Create product",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productIdentifier\": \"{{productIdentifier}}\",\n  \"nome\": \"Produto criado pelo Postman\",\n  \"descricao\": \"Produto para teste da API\",\n  \"preco\": 99.90,\n  \"category\": {\n    \"id\": {{categoryId}},\n    \"nome\": \"Eletronico\"\n  }\n}"
            },
            "url": "{{baseUrl}}/product"
          }
        },
        {
          "name": "Edit product by id",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productIdentifier\": \"{{productIdentifier}}\",\n  \"nome\": \"Produto atualizado pelo Postman\",\n  \"descricao\": \"Produto atualizado para teste da API\",\n  \"preco\": 109.90,\n  \"category\": {\n    \"id\": {{categoryId}},\n    \"nome\": \"Eletronico\"\n  }\n}"
            },
            "url": "{{baseUrl}}/product/{{productId}}"
          }
        },
        {
          "name": "Delete product by id",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/product/{{productId}}"
          }
        }
      ]
    }
  ]
}